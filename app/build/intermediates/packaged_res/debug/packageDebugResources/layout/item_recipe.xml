<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/bg_card" android:layout_marginBottom="10dp" android:padding="16dp">
    <TextView android:id="@+id/txtRecipeName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="19sp" android:textStyle="bold" android:textColor="@color/green_900"/>
    <TextView android:id="@+id/txtRecipeMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="All ingredients available" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="5dp"/>
    <Button android:id="@+id/btnViewRecipe" android:layout_width="wrap_content" android:layout_height="42dp"
        android:text="View recipe" android:textColor="@color/surface" android:background="@drawable/bg_primary_button"
        android:layout_marginTop="10dp"/>
</LinearLayout>
