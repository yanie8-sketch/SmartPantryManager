<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/green_100"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/green_700"/></shape>
    </item>
    <item android:state_hovered="true">
        <shape><solid android:color="#E8F8EF"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/green_600"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="#BFD8CB"/></shape>
    </item>
</selector>
