<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/bg_card" android:layout_marginBottom="10dp" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ink"/>
            <TextView android:id="@+id/txtQuantity" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/txtExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/warning" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <Button android:id="@+id/btnEdit" android:layout_width="wrap_content" android:layout_height="42dp"
            android:text="Edit" android:textColor="@color/green_900" android:background="@drawable/bg_secondary_button"/>
        <Button android:id="@+id/btnDelete" android:layout_width="wrap_content" android:layout_height="42dp"
            android:text="Delete" android:textColor="@color/danger" android:background="@drawable/bg_secondary_button"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
